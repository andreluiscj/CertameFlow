# Conexao com o Postgres do Supabase.
# Painel do Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.<project_id>:<senha>@<host>:5432/postgres

# Validacao do token emitido pelo Supabase Auth.
# Use o mesmo valor de VITE_SUPABASE_PROJECT_ID do frontend no lugar de <project_id>.
SUPABASE_ISSUER_URI=https://<project_id>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<project_id>.supabase.co/auth/v1/.well-known/jwks.json

# Origens liberadas no CORS, separadas por virgula.
CORS_ORIGENS=http://localhost:8080

PORT=8081
