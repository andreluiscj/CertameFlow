# Conexao com o Postgres do Supabase.
# Painel do Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.<project_id>:<senha>@<host>:5432/postgres

# Validacao do token emitido pelo Supabase Auth.
# Use o mesmo valor de VITE_SUPABASE_PROJECT_ID do frontend no lugar de <project_id>.
SUPABASE_ISSUER_URI=https://<project_id>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<project_id>.supabase.co/auth/v1/.well-known/jwks.json

# Origens liberadas no CORS, separadas por virgula.
CORS_ORIGENS=http://localhost:8080

PORT=8081

# Chave service_role do Supabase (Project Settings > API > service_role).
# NUNCA use esta chave no frontend. Necessaria para a tela de Administracao
# (criar/excluir usuarios, redefinir senha) e para os comprovantes de pagamento.
SUPABASE_SERVICE_ROLE_KEY=

# Resumo diario de tarefas e parcelas atrasadas por e-mail (SMTP).
# Sem SMTP_HOST o envio fica desligado. Exemplo com Gmail: smtp.gmail.com, porta
# 587, e uma "senha de app" (Conta Google > Seguranca > Senhas de app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Hora (0-23) a partir da qual o resumo do dia e enviado, e o fuso usado.
NOTIFICACOES_HORA=8
NOTIFICACOES_FUSO=America/Sao_Paulo
# Endereco do frontend, usado no link do e-mail.
URL_SISTEMA=http://localhost:8080
